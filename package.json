{
  "name": "cascade-solitaire",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "yandex:dev": "pnpm build && pnpm dlx @yandex-games/sdk-dev-proxy -p dist --dev-mode=true",
    "test": "node --test tests/*.test.ts tests/*.test.mjs",
    "generate:winnable-pool": "D:\\msys64\\ucrt64\\bin\\g++.exe -std=c++20 -O3 -pthread tools/sawayama_solver.cpp -o tools/sawayama_solver.exe && tools\\sawayama_solver.exe --genpool --start 1 --count 4096 --limit 512 --budget 250000 --jobs 4 --out src/game/model/winnableSeeds.ts",
    "context": "node scripts/chatgpt-context.mjs",
    "context:last": "node scripts/chatgpt-context.mjs --last-commit"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
