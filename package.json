{
  "name": "cascade-solitaire",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "yandex:dev": "pnpm build && node scripts/yandex-dev-proxy.mjs",
    "test": "node --test tests/*.test.ts tests/*.test.mjs",
    "generate:winnable-pool": "D:\\msys64\\ucrt64\\bin\\g++.exe -std=c++20 -O3 -pthread tools/sawayama_solver.cpp -o tools/sawayama_solver.exe && tools\\sawayama_solver.exe --genpool --start 1 --count 4096 --limit 512 --budget 250000 --jobs 4 --out src/game/model/winnableSeeds.ts",
    "deals:build-solver": "node tools/deals/build-solver.mjs",
    "context": "node scripts/chatgpt-context.mjs",
    "context:last": "node scripts/chatgpt-context.mjs --last-commit",
    "deals:generate": "node tools/deals/generate.mjs",
    "deals:verify-sample": "node --test tests/verified-proof-sample.test.ts",
    "deals:verify-all": "node tools/deals/verify-all.mjs",
    "deals:report": "node tools/deals/report.mjs",
    "deals:probe": "node tools/deals/probe.mjs",
    "build:pikabu": "tsc && vite build --mode pikabu",
    "backend:test": "node --test --experimental-strip-types tests/cloudflare-*.test.ts tests/cloudflare-*.test.mjs tests/backend-*.test.ts tests/backend-*.test.mjs tests/bridge-session.test.ts tests/d1-*.test.ts tests/pikabu-signed-data.test.ts",
    "backend:setup:d1": "node scripts/setup-cloudflare-d1.mjs",
    "backend:dev:cloudflare": "pnpm dlx wrangler@4.135.0 dev",
    "backend:build:cloudflare": "pnpm dlx wrangler@4.135.0 deploy --dry-run --outdir dist/cloudflare-worker",
    "backend:deploy:cloudflare": "pnpm dlx wrangler@4.135.0 deploy",
    "backend:smoke:cloudflare": "node scripts/cloudflare-backend-smoke.mjs"
  },
  "dependencies": {
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "esbuild": "^0.28.2"
  }
}
